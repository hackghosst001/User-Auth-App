<!DOCTYPE html>
<html>
  <head>
    <title>User Profile</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
 <body>
  <h2 style="border:4px solid red; padding:10px;"><b><strong>Welcome <%= user.name %> "To Lauda ka Sarkar App"</strong></b></h2>
  <br />
<div style="display: flex; justify-content: center; width: 100%; padding-top: 50px;">
  
  <div style="width: 100%; max-width: 1000px; overflow: hidden; border: 1px solid #ddd; padding: 20px; border-radius: 8px;">

    <div style="float: left; width: 55%;">
      <div style="float: left; margin-right: 20px; border: 2px solid black; padding: 10px; text-align: center;">
        <strong>From</strong><br />
        <img src="/media/lawda-sarkar.png" alt="Auth Image" width="200" />
      </div>

      <div style="float: left; border: 2px solid black; padding: 10px; text-align: center;">
        <strong>To</strong><br />
        <img src="/media/sarkar.gif" alt="Auth Image" width="200" />
      </div>
      <div style="clear: both;"></div>
    </div>

    <div style="float: right; width: 35%; background: #f9f9f9; padding: 15px; border-radius: 5px;">
        <div style="border:2px solid black; padding:10px;">
            <p style="padding-left:70px;"><b><strong>Profile-Details</strong></b></p>
            <p><strong>Name:</strong> <%= user.name %></p>
            <p><strong>Email:</strong> <%= user._id %></p>
        </div>
      

      <form action="/update-password" method="post">
        <input type="hidden" name="email" value="<%= user._id %>" />
        <label>Edit Password:</label><br />
        <input type="password" name="password" required style="width: 100%;" /><br /><br />
        <button type="submit" style="width: 100%;">Save Password</button>
      </form>
    </div>

  </div>
</div>

  </div> <hr /> <div style="margin-top: 20px;">
    <a href="/login-history?email=<%= user._id %>">
      <button style="float: left;">Login History</button>
    </a>
    <a href="/">
      <button style="float: right; margin-right: 20px;">Home</button>
    </a>
  </div>

</body>
</html>
